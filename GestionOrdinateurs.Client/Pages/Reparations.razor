@page "/reparations"
@attribute [Authorize(Roles = "Admin")]
@using System.Net.Http.Headers
@inject HttpClient Http
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage

<PageTitle>Réparations</PageTitle>

<h1>Historique des réparations</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
else if (reparations is null)
{
    <p>Chargement...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Ordinateur</th>
                <th>Technicien</th>
                <th>Réparation</th>
                <th>Date d'intervention</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var reparation in reparations)
            {
                <tr>
                    <td>@reparation.NomOrdinateur</td>
                    <td>@reparation.Technicien</td>
                    <td>@reparation.TypeReparation</td>
                    <td>@reparation.DateIntervention.ToString("g")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<HistoriqueReparationDto>? reparations;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var token = await SessionStorage.GetItemAsync<string>("jwtToken");
        if (string.IsNullOrWhiteSpace(token))
        {
            errorMessage = "Connectez-vous pour consulter les réparations.";
            return;
        }

        using var request = new HttpRequestMessage(HttpMethod.Get, "api/reparation/historique");
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

        try
        {
            using var response = await Http.SendAsync(request);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = $"Impossible de charger les réparations (HTTP {(int)response.StatusCode}).";
                return;
            }

            reparations = await response.Content.ReadFromJsonAsync<List<HistoriqueReparationDto>>()
                ?? throw new System.Text.Json.JsonException("La réponse de l'API est vide.");
        }
        catch (HttpRequestException)
        {
            errorMessage = "La Gateway est indisponible.";
        }
    }

    private sealed class HistoriqueReparationDto
    {
        public int OrdinateurId { get; set; }
        public string NomOrdinateur { get; set; } = string.Empty;
        public string Technicien { get; set; } = string.Empty;
        public string TypeReparation { get; set; } = string.Empty;
        public DateTime DateIntervention { get; set; }
    }
}
