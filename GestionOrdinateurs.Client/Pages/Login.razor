@page "/login"
@using System.Net.Http.Json
@using GestionOrdinateurs.Client.Auth
@inject HttpClient Http
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@inject NavigationManager Navigation
@inject JwtAuthenticationStateProvider AuthProvider

<PageTitle>Connexion</PageTitle>

<h1>Connexion</h1>

<div class="row">
    <div class="col-md-4">
        <div class="form-group mb-3">
            <label for="login">Login (ex. user1) :</label>
            <input id="login" @bind="login" class="form-control" placeholder="Entrez votre identifiant" />
        </div>

        <button class="btn btn-primary mt-2" @onclick="SeConnecter">
            Se connecter
        </button>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-3" role="alert">@errorMessage</div>
        }
    </div>
</div>

@code {
    private string login = string.Empty;
    private string errorMessage = string.Empty;

    private async Task SeConnecter()
    {
        errorMessage = string.Empty;
        if (string.IsNullOrWhiteSpace(login))
        {
            errorMessage = "Saisissez un login.";
            return;
        }

        try
        {
            using var response = await Http.PostAsJsonAsync("api/authentication/login", login.Trim());
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = response.StatusCode == System.Net.HttpStatusCode.Unauthorized
                    ? "Il n'existe pas."
                    : $"Échec de la connexion (HTTP {(int)response.StatusCode}).";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<TokenResponse>();
            if (result is null || string.IsNullOrWhiteSpace(result.Token))
            {
                errorMessage = "La réponse de connexion ne contient pas de token.";
                return;
            }

            await SessionStorage.SetItemAsync("jwtToken", result.Token);
            AuthProvider.NotifyUserAuthentication(result.Token);
            Navigation.NavigateTo("/");
        }
        catch (HttpRequestException)
        {
            errorMessage = "La Gateway ou le service d'authentification est indisponible.";
        }
    }

    private sealed class TokenResponse
    {
        public string Token { get; set; } = string.Empty;
    }
}
