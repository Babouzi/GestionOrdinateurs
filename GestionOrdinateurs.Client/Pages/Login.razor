@page "/login"
@using System.Net.Http.Json
@using GestionOrdinateurs.Client.Auth
@inject HttpClient Http
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@inject NavigationManager Navigation
@inject JwtAuthenticationStateProvider AuthProvider

<PageTitle>Connexion</PageTitle>

<h1>Connexion</h1>

<div class="row">
    <div class="col-md-4">
        <div class="form-group mb-3">
            <label for="login">Nom d'utilisateur :</label>
            <input id="login" @bind="username" class="form-control" autocomplete="username" placeholder="Entrez votre nom d'utilisateur" />
        </div>
        <div class="form-group mb-3">
            <label for="password">Mot de passe :</label>
            <input id="password" type="password" @bind="password" class="form-control" autocomplete="current-password" />
        </div>

        <button class="btn btn-primary mt-2" @onclick="SeConnecter">
            Se connecter
        </button>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-3" role="alert">@errorMessage</div>
        }
    </div>
</div>

@code {
    private string username = string.Empty;
    private string password = string.Empty;
    private string errorMessage = string.Empty;

    private async Task SeConnecter()
    {
        errorMessage = string.Empty;
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Saisissez votre nom d'utilisateur et votre mot de passe.";
            return;
        }

        try
        {
            using var response = await Http.PostAsJsonAsync("api/authentication/login", new
            {
                username = username.Trim(),
                password
            });
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = response.StatusCode == System.Net.HttpStatusCode.Unauthorized
                    ? "Nom d'utilisateur ou mot de passe incorrect."
                    : $"Échec de la connexion (HTTP {(int)response.StatusCode}).";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<TokenResponse>();
            var token = result?.AccessToken ?? result?.Token;
            if (string.IsNullOrWhiteSpace(token))
            {
                errorMessage = "La réponse de connexion ne contient pas de token.";
                return;
            }

            await SessionStorage.SetItemAsync("jwtToken", token);
            AuthProvider.NotifyUserAuthentication(token);
            Navigation.NavigateTo("/");
        }
        catch (HttpRequestException)
        {
            errorMessage = "La Gateway ou le service d'authentification est indisponible.";
        }
    }

    private sealed class TokenResponse
    {
        [System.Text.Json.Serialization.JsonPropertyName("access_token")]
        public string? AccessToken { get; set; }

        public string? Token { get; set; }
    }
}
